# ============================================================
# Git 忽略规则 — Cnkrru's Blog
# ============================================================

# --- 依赖 & 构建产物 ---
node_modules/
dist/
dist-ssr/
*.local

# --- 日志 ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- 编辑器 & IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- 项目自定义忽略 ---
app/
release/
temp/
desktop/
script/

# --- TypeScript ---
*.tsbuildinfo

# --- Vite ---
.vite/
.vite-ssg-temp/

# --- 环境变量 ---
.env
.env.local
.env.*.local

# --- 测试覆盖率 ---
coverage/

# --- 构建包 ---
*.tgz

# --- 临时文件 ---
*.tmp
*.temp
*.cache
*.pid
*.seed

# --- 错误报告 ---
error-reports/

# --- 操作系统 ---
Thumbs.db
ehthumbs.db

# --- 文档（迁移记录，不纳入版本） ---
JS_TO_TS_MIGRATION.md