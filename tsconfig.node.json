{
  "compilerOptions": {
    // Vite 构建工具的 TS 配置 - Cnkrru's Blog
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["vite.config.ts", "src/plugins/**/*.ts"]
}
